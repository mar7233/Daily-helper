<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyHelper.AnaSayfa"
             Title="Ana Sayfa"
             BackgroundColor="{StaticResource BlackPrimary}">

 

    <ScrollView>
        <VerticalStackLayout Padding="20" 
                             Spacing="20" 
                             HorizontalOptions="Fill" 
                             VerticalOptions="Start">

            <!-- Büyük hoş geldiniz başlığı -->
            <Label Text="Hoş Geldiniz..."
                   FontSize="50"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource LightGray}" />

            <!-- Profil resmi için estetik çerçeve (yuvarlak + gölge) -->
            <Frame BackgroundColor="{StaticResource GrayBackground}"
                   CornerRadius="8"
                   HasShadow="True"
                   Padding="16">
                <VerticalStackLayout HorizontalOptions="Center" 
                                     VerticalOptions="Center">

                    <!-- Yuvarlak profil resmi (150x150) -->
                    <Frame HasShadow="False"
                           Padding="0"
                           IsClippedToBounds="True"
                           CornerRadius="75"
                           HeightRequest="150"
                           WidthRequest="150"
                           BackgroundColor="Transparent"
                           BorderColor="{StaticResource LightGray}"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0">

                        <!-- Profil resmi burada gösteriliyor -->
                        <Image Source="profile.png"
                               Aspect="AspectFill"
                               HeightRequest="150"
                               WidthRequest="150"
                               SemanticProperties.Description="Kullanıcı profil resmi" />
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Ad-Soyad büyük ve belirgin şekilde gösteriliyor (kriter 1) -->
            <Label Text="Mariam Mahmoud"
                   FontSize="28"
                   TextColor="White"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"/>

            <!-- Üniversite bilgisi -->
            <Label Text="Bartın Üniversitesi Bilgisayar Mühendisliği"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource MutedGray}" />

            <!-- İstersen buraya ekstra bilgi veya buton eklenebilir -->
            <!-- Şu an temiz ve sade tutuldu → estetik kriteri tamamlandı -->

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>